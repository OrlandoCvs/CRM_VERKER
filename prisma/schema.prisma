// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // La app usa la conexión POOLED (con -pooler): en serverless (Vercel) muchas
  // instancias comparten el pool y no saturan la base.
  url       = env("DATABASE_URL")
  // Las migraciones usan la conexión DIRECTA (sin -pooler): un pooler no soporta
  // los comandos DDL/transaccionales que necesita `migrate deploy`.
  directUrl = env("DIRECT_URL")
}

model Lead {
  id                String    @id @default(cuid())
  name              String
  email             String?
  phone             String?
  company           String?
  website           String?
  address           String?
  city              String?
  country           String?
  category          String?
  rating            Float?
  reviewCount       Int?
  source            String    @default("manual")
  sourceQuery       String?
  placeId           String?   @unique
  status            String    @default("new")
  notes             String?
  tags              String?
  // Location coordinates
  lat               Float?
  lng               Float?
  // Extended place data
  imageUrl          String?
  description       String?
  price             String?
  permanentlyClosed Boolean?  @default(false)
  temporarilyClosed Boolean?  @default(false)
  // Social media (from Apify company contacts enrichment)
  instagram         String?
  facebook          String?
  linkedin          String?
  youtube           String?
  tiktok            String?
  twitter           String?
  pinterest         String?
  // JSON fields
  openingHours      String?
  webResults        String?
  // Folder organization
  folderId          String?
  folder            Folder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  // Estado de entregabilidad del email (lo actualiza el webhook de Resend).
  //   unknown     → sin envíos todavía
  //   valid       → al menos un correo entregado
  //   bounced     → rebote duro: la dirección no existe, no volver a enviar
  //   complained  → marcó el correo como spam, no volver a contactar nunca
  emailStatus       String    @default("unknown")
  emailStatusAt     DateTime?
  emailStatusReason String?
  // Baja voluntaria. Cuando tiene fecha, el CRM no vuelve a escribir a este
  // lead: lo exige la ley y, en la práctica, seguir enviando dispara las
  // quejas por spam y hunde la reputación del dominio.
  unsubscribedAt    DateTime?
  unsubscribeSource String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  activities      Activity[]
  contacts        Contact[]
  emailDeliveries EmailDelivery[]
  reminders       Reminder[]

  @@index([folderId])
  @@index([emailStatus])
  @@index([unsubscribedAt])
}

/// Correos enviados por el CRM. Guarda el id que devuelve el proveedor para
/// poder casar los eventos del webhook (rebotes, quejas) con su lead.
model EmailDelivery {
  id         String   @id @default(cuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  providerId String   @unique
  to         String
  subject    String
  status     String   @default("sent")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([leadId])
}

model Folder {
  id        String   @id @default(cuid())
  name      String
  color     String?
  parentId  String?
  parent    Folder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Folder[] @relation("FolderTree")
  leads     Lead[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}

model Contact {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  phone     String?
  role      String?
  createdAt DateTime @default(now())
}

model Activity {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      String
  note      String
  createdAt DateTime @default(now())
}

/// Tarea de seguimiento pendiente sobre un lead ("volver a llamar el jueves").
/// A diferencia de Activity (registro de lo ya ocurrido), un Reminder mira al
/// futuro: tiene fecha de vencimiento y un estado de completado.
model Reminder {
  id          String    @id @default(cuid())
  leadId      String
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  title       String
  dueAt       DateTime
  done        Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Consultas típicas: pendientes de un lead, y agenda global por vencimiento.
  @@index([leadId])
  @@index([done, dueAt])
}

model EmailTemplate {
  id          String            @id @default(cuid())
  name        String
  subject     String
  body        String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  attachments EmailAttachment[]
}

/// Archivo adjunto fijo de una plantilla: se envía siempre que se usa esa
/// plantilla. El binario se guarda en la propia base de datos (campo `data`)
/// porque el hosting serverless (Vercel) no tiene disco persistente donde
/// escribir. Para adjuntos de plantillas —pocos y pequeños— es adecuado.
model EmailAttachment {
  id         String        @id @default(cuid())
  templateId String
  template   EmailTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  filename   String
  mimeType   String
  size       Int
  data       Bytes
  createdAt  DateTime      @default(now())

  @@index([templateId])
}

/// Historial de búsquedas de prospectos (Google Places y LinkedIn).
///
/// Cada búsqueda cuesta créditos de Apify, así que sus resultados se conservan
/// aquí en vez de depender del dataset de Apify, que se borra a los pocos días
/// en el plan gratuito. Permite reabrir una búsqueda pasada y decidir a quién
/// importar sin volver a pagarla.
///
/// Se limpia solo: las búsquedas de más de 30 días se borran al listar el
/// historial (ver `lib/search-history.ts`).
model SearchRun {
  id          String   @id @default(cuid())
  /// 'google_places' | 'linkedin'. Determina qué campos trae cada perfil.
  source      String   @default("linkedin")
  /// Criterios en texto legible, para reconocerla en la lista.
  label       String
  /// Filtros exactos, en JSON, por si se quiere repetir la búsqueda.
  filters     String?
  /// Id de la ejecución en Apify, para poder rastrearla allí.
  runId       String?
  resultCount Int      @default(0)
  emailCount  Int      @default(0)
  /// Coste real en dólares, cuando Apify lo informa.
  costUsd     Float?
  createdAt   DateTime @default(now())

  results SearchResult[]

  @@index([source, createdAt])
  @@index([createdAt])
}

/// Resultado guardado de una búsqueda, ya normalizado.
///
/// Sirve para las dos fuentes: un negocio de Google Places y una persona de
/// LinkedIn comparten nombre, empresa, contacto y ubicación. Lo que solo tiene
/// una de ellas (horarios, reseñas, experiencia laboral) NO se guarda: ocuparía
/// mucho y para decidir si importar basta con lo esencial. Al importar se crea
/// el lead con estos campos.
model SearchResult {
  id             String    @id @default(cuid())
  runId          String
  run            SearchRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  /// Identificador en su origen: placeId de Google, o id de perfil de LinkedIn.
  externalId     String
  name           String
  /// Titular de LinkedIn o categoría del negocio, según la fuente.
  headline       String?
  company        String?
  /// Cargo (LinkedIn) o categoría del negocio (Places).
  position       String?
  email          String?
  phone          String?
  website        String?
  address        String?
  city           String?
  country        String?
  /// URL del perfil de LinkedIn; vacío en resultados de Places.
  linkedinUrl    String?
  photo          String?
  about          String?
  /// Nº de contactos (LinkedIn) o de reseñas (Places).
  connections    Int?
  rating         Float?
  /// Lead creado a partir de este resultado, si ya se importó.
  importedLeadId String?
  createdAt      DateTime  @default(now())

  @@index([runId])
}
