// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id                String   @id @default(cuid())
  name              String
  email             String?
  phone             String?
  company           String?
  website           String?
  address           String?
  city              String?
  country           String?
  category          String?
  rating            Float?
  reviewCount       Int?
  source            String   @default("manual")
  sourceQuery       String?
  placeId           String?  @unique
  status            String   @default("new")
  notes             String?
  tags              String?
  // Location coordinates
  lat               Float?
  lng               Float?
  // Extended place data
  imageUrl          String?
  description       String?
  price             String?
  permanentlyClosed Boolean? @default(false)
  temporarilyClosed Boolean? @default(false)
  // Social media (from Apify company contacts enrichment)
  instagram         String?
  facebook          String?
  linkedin          String?
  youtube           String?
  tiktok            String?
  twitter           String?
  pinterest         String?
  // JSON fields
  openingHours      String?
  webResults        String?
  // Folder organization
  folderId          String?
  folder            Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  // Estado de entregabilidad del email (lo actualiza el webhook de Resend).
  //   unknown     → sin envíos todavía
  //   valid       → al menos un correo entregado
  //   bounced     → rebote duro: la dirección no existe, no volver a enviar
  //   complained  → marcó el correo como spam, no volver a contactar nunca
  emailStatus       String   @default("unknown")
  emailStatusAt     DateTime?
  emailStatusReason String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  activities   Activity[]
  contacts     Contact[]
  emailDeliveries EmailDelivery[]
  reminders    Reminder[]

  @@index([folderId])
  @@index([emailStatus])
}

/// Correos enviados por el CRM. Guarda el id que devuelve el proveedor para
/// poder casar los eventos del webhook (rebotes, quejas) con su lead.
model EmailDelivery {
  id         String   @id @default(cuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  providerId String   @unique
  to         String
  subject    String
  status     String   @default("sent")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([leadId])
}

model Folder {
  id        String   @id @default(cuid())
  name      String
  color     String?
  parentId  String?
  parent    Folder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Folder[] @relation("FolderTree")
  leads     Lead[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}

model Contact {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  phone     String?
  role      String?
  createdAt DateTime @default(now())
}

model Activity {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      String
  note      String
  createdAt DateTime @default(now())
}

/// Tarea de seguimiento pendiente sobre un lead ("volver a llamar el jueves").
/// A diferencia de Activity (registro de lo ya ocurrido), un Reminder mira al
/// futuro: tiene fecha de vencimiento y un estado de completado.
model Reminder {
  id          String    @id @default(cuid())
  leadId      String
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  title       String
  dueAt       DateTime
  done        Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Consultas típicas: pendientes de un lead, y agenda global por vencimiento.
  @@index([leadId])
  @@index([done, dueAt])
}

model EmailTemplate {
  id          String            @id @default(cuid())
  name        String
  subject     String
  body        String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  attachments EmailAttachment[]
}

/// Archivo adjunto fijo de una plantilla: se envía siempre que se usa esa
/// plantilla. El binario se guarda en la propia base de datos (campo `data`)
/// porque el hosting serverless (Vercel) no tiene disco persistente donde
/// escribir. Para adjuntos de plantillas —pocos y pequeños— es adecuado.
model EmailAttachment {
  id         String        @id @default(cuid())
  templateId String
  template   EmailTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  filename   String
  mimeType   String
  size       Int
  data       Bytes
  createdAt  DateTime      @default(now())

  @@index([templateId])
}
